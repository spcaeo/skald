{
 "about": "A Next.js front whose answers set Laravel's cookies (the API behind the same name)",
 "typed": "app.example.com",
 "pages": {
  "GET https://app.example.com/": {
   "status": 200,
   "headers": {
    "Server": "nginx",
    "X-Powered-By": "Next.js",
    "Set-Cookie": [
     "XSRF-TOKEN=eyJpdiI6IkV4YW1wbGUifQ; path=/; samesite=lax",
