{
 "about": "A plain static site on Netlify: nothing applies",
 "typed": "www.example.com",
 "pages": {
  "GET https://www.example.com/": {
   "status": 200,
   "headers": {
    "Server": "Netlify",
    "X-Nf-Request-Id": "01JABCDEF0123456789",
    "Strict-Transport-Security": "max-age=31536000",
    "X-Content-Type-Options": "nosniff",
    "Content-Security-Policy": "default-src 'self'; frame-ancestors 'self'",
    "Referrer-Policy": "strict-origin-when-cross-origin"
   },
   "body": "<!doctype html><html><head><title>Hello</title></head><body><p>Hi</p></body></html>"
  }
 },
 "expect": {
  "summary": "Your site is hosted on Netlify. Nothing to do now.",
  "cards": [
   [
    "good",
    "Security headers: all 5 set"
   ],
   [
    "nothing",
    "Nothing we know of applies"
   ]
  ],
  "products": [
   "Netlify @www.example.com"
  ]
 }
}
